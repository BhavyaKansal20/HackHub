# ============================================================
# HackHub — Environment Variables Reference
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local — only .env.example goes to git.
# ============================================================

# ----- Supabase (required) ----------------------------------
# Supabase project URL (safe to expose — no secrets)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key — safe to expose client-side
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Used by Lovable cloud-auth — same as publishable key
SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Supabase project URL (server-side alias)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key — SERVER ONLY, never prefix with VITE_
# Grants full DB access; keep secret
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ----- Cron / Webhooks (required for sync job) --------------
# Secret used to authenticate cron POST requests
# Generate: openssl rand -hex 32
LOVABLE_CRON_SECRET=<generate-with-openssl-rand-hex-32>
# Optional: previous secret during rotation
LOVABLE_CRON_SECRET_PREVIOUS=

# ----- AI (optional — for blueprint evaluation) -------------
# Server-only key — never prefix with VITE_
# If using OpenAI:
OPENAI_API_KEY=<your-openai-api-key>

# If using Groq (free tier available):
GROQ_API_KEY=<your-groq-api-key>

# ----- Lovable Platform (auto-set in Lovable cloud) ---------
# Do NOT set these manually unless you know what you're doing
# LOVABLE_PROJECT_ID=
# LOVABLE_API_KEY=
